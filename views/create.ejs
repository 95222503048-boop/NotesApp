<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Note | Notes App</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body class="page-shell">
    <main class="container form-container">
        <a class="back-link" href="/home">&larr; Back to notes</a>
        <div class="form-heading">
            <p class="eyebrow">Make a note of it</p>
            <h1>Create note</h1>
            <p class="intro">Put the thought somewhere you can find it again.</p>
        </div>
        <form class="note-form" action="/create" method="POST">
            <label for="title">Title</label>
            <input type="text" id="title" name="title" placeholder="What is on your mind?" required>
            <label for="content">Content</label>
            <textarea id="content" name="content" placeholder="Start writing..." required></textarea>
            <div class="form-actions">
                <a class="button button-quiet" href="/home">Cancel</a>
                <button class="button button-primary" type="submit">Create note</button>
            </div>
        </form>
    </main>
</body>
</html>